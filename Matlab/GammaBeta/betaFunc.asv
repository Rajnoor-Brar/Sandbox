function [output] = betaFunc(a,b)

arguments (Input)
    a double
    b double
end

arguments (Output)
    output double
end

tStart = 0; tEnd = 1; nSteps = 500;
edgeGap = 0.001;

dt = (tEnd-tStart)/nSteps;
output = 0;

for t = (tStart+ edgeGap):dt:(tEnd-edgeGap)
    output = output+ t^(a-1)* (1-t)^(b-1)*dt;
end